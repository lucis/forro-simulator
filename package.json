{
  "name": "forro-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
